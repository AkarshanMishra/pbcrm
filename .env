# ==============================================================================
# PCRM Phase 1 - Environment Configuration
# ==============================================================================

# Django Core
DEBUG=True
SECRET_KEY=django-insecure-replace-this-with-a-secure-key-in-production-64chars-min
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,backend
DJANGO_SETTINGS_MODULE=config.settings.development

# PostgreSQL Database
DB_NAME=pcrm_db
DB_USER=pcrm_user
DB_PASSWORD=pcrm_secure_password_123!
DB_HOST=localhost
DB_PORT=5432

# Redis Cache & Sessions
REDIS_URL=redis://localhost:6379/1

# JWT Settings
JWT_SECRET_KEY=jwt-secret-replace-in-prod-secure-random-key-here
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# MFA Settings
MFA_ISSUER_NAME=PCRM_Enterprise
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=noreply@example.com
EMAIL_HOST_PASSWORD=sample_email_password
DEFAULT_FROM_EMAIL=PCRM Security <noreply@example.com>

# Security Throttling & Lockout
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
